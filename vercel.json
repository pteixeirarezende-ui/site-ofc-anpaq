    },
    {
      "source": "/component/content/article/10-legisla%C3%A7%C3%A3o/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index.php",
      "has": [
        {
          "type": "query",
          "key": "option",
          "value": "com_djcatalog2"
        }
      ],
      "destination": "/associados/",
      "permanent": true
    },
    {
      "source": "/index.php",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/noticias/:path*",
      "destination": "/",
