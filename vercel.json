    },
    {
      "source": "/associados/associado-fornecedor-e-prestador-de-serviço.html",
      "destination": "/associados/?tipo=fornecedor",
      "permanent": true
    },
    {
      "source": "/associados/associado-fornecedor-e-prestador-de-servi%C3%A7o.html",
      "destination": "/associados/?tipo=fornecedor",
      "permanent": true
    },
    {
      "source": "/anuário/:path*",
